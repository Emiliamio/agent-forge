# ==========================================
# AgentForge 环境变量配置模版
# ==========================================

# 数据库配置 (PostgreSQL 16 + pgvector)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agentforge
DB_USER=postgres
DB_PASSWORD=password123

# Redis 缓存与限流配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis123

# LLM 与 Embedding 基础配置 (按需配置默认 Key)
OPENAI_API_KEY=sk-placeholder
OPENAI_BASE_URL=https://api.openai.com/v1

DEEPSEEK_API_KEY=sk-placeholder
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 向量维度默认配置 (如 1536 对应 text-embedding-3-small, 1024 对应 bge-large-zh)
DEFAULT_EMBEDDING_DIMENSION=1536

# JWT 鉴权密钥
JWT_SECRET=agentforge-enterprise-secret-key-32bytes-min!
JWT_EXPIRATION=86400000
